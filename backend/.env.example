PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/driving
MONGO_CONNECT_RETRIES=5
JWT_SECRET=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173

# Optional: used by local repair/audit scripts to target your existing admin.
# The server does not create or overwrite admin accounts automatically.
ADMIN_EMAIL=admin@example.com

# Optional: required for OTP, welcome, and admin reply emails.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
